<% content_for(:title, '新規カフェ登録') %>
<div class="container">
 <div class="row">
  <div class="col-lg-8 offset-lg-2">
     <h1>新規カフェ登録</h1>
     <%= render "shared/error_message", object: @board %>
      <%= form_with model: @board, class:"new board" do |f| %>
        <div class="mb-3">
         <%= f.label :shop_name, '店名' %>
         <%= f.text_field :title, class:"form-control" %>
        </div>
        <div class="mb-3">
         <%= f.label :body,'ここがおすすめ！' %>
         <%= f.text_area :body,class:"form-control",placeholder:"お店に行ったら注目して欲しいポイントを紹介してください！",rows:10 %>
         </div>
        <div class="mb-3">
          <%= f.label :board_image ,'お店の参考画像'%>
          <%= f.file_field :board_image, class: "form-control", accept: 'image/*' %>
          <%= f.hidden_field :board_image_cache %>
        </div>
     <%= f.submit '登録', class:"btn btn-primary" %>
     <% end %>
   </div>
  </div>
</div>