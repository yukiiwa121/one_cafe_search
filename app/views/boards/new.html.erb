<div class="container">
 <div class="row">
  <div class="col-lg-8 offset-lg-2">
     <h1>新規カフェ登録</h1>
     <%= render "shared/error_message", object: @board %>
      <%= form_with model: @board, class:"new board" do |f| %>
        <div class="mb-3">
         <%= f.label :shop_name, '店名' %>
         <%= f.text_field :title, class:"form-control" %>
        </div>
        <div class="mb-3">
         <%= f.label :body,'ここがおすすめ！(お店に行ったら注目して欲しいポイントを紹介してくだい！)' %>
         <%= f.text_area :body,class:"form-control",rows:"10" %>
        </div>
     <%= f.submit '登録', class:"btn btn-primary" %>
     <% end %>
   </div>
  </div>
</div>