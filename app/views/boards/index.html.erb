<% content_for :title do %> おすすめカフェ一覧 <% end %>
<div class="container pt-3">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <!-- 検索フォーム -->
      <form>
        <div class="input-group mb-3"><input class="form-control" placeholder="検索ワード" type="search"/>
          <div class="input-group-append"><input type="submit" value="カフェを探す" class="btn btn-primary"/></div>
        </div>
      </form>
    </div>
  </div>

  <!-- 掲示板一覧 -->
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @boards.present? %>
          <%= render @boards %>
            <!--アンダーボードに記載 -->
        <% else %>
          <div class="mb-3">おすすめのお店がありません</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
