<div class="col-sm-12 col-md-6 col-lg-4 mb-3">
      <div id="board-id-<%= board.id %>">  
    <!-- 画像と検索窓 -->    
               <div class="shop-card position-relative">  
                  <%= image_tag board.board_image.url, class: "shop-img-top", width: "100%", height:"120" %>

                <div class="shop-body">
                    <div class="d-flex justify-content-between align-items-start w-100">
                <ul class="list-unstyled shop-list mb-0">
    <!-- 店名-->
                      <li class="shop-title text-wrap">
                        <%= link_to truncate(board.title.to_s, length: 20), board_path(board) %>
                      </li>
   <!-- google-->
                     <li>
                      <%= link_to "Googleでお店を検索",
                         "https://www.google.com/search?q=#{CGI.escape(board.title)}",
                          target: "_blank",rel: "noopener", class: "btn btn-outline-primary" %>
                     </li>
   <!-- 説明-->
                     <li class="shop-text text-wrap">
                        <div class="fw-bold">ここがおすすめ！</div>
                        <div class="text-break"><%= truncate(board.body.to_s, length: 23) %></div>
                     </li>
    <!--ユーザー名-->     
                      <li>
                        <i class="bi bi-person"></i>
                         <%= board.user.name %>
                      </li>
    <!--作成日-->
                      <li>
                        <i class="bi bi-calendar"></i>
                        <%= l board.created_at, format: :short %>
                      </li>
                </ul>
    <!--各種ボタン-->
                     <% if board.user_id == current_user&.id %>
                       <div class='position-absolute bottom-0 end-0 p-2 d-flex gap-2'>
                        <%= link_to edit_board_path(board), id: "button-edit-#{board.id}" do %>
                          <i class="bi bi-pencil-fill"></i>
                        <% end %>

                        <%= link_to board_path(board),
                             data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },id: "button-delete-#{board.id}" do %>
                          <i class="bi bi-trash-fill"></i>
                        <% end %>
                      </div>
                     <% end %>
                  
                    </div>
              </div>
            </div>
          </div>
        </div>
       
        
          