<div class="col-sm-12 col-lg-4 mb-3">
              <div id="board-id-<%= board.id %>">
                <div class="shop-card">
                  <%= image_tag board.board_image_url, class: "shop-img-top", width: "200", height:"100" %>
                  <div class="shop-body">
                    <div class="d-flex">
          <ul class="list-unstyled shop-list">
    <!-- 店名-->
                      <li class="shop-title">
                        <%= link_to board.title, board_path(board) %>
                      </li>
   <!-- google-->
                     <li>
                      <%= link_to "Googleでお店を検索",
                         "https://www.google.com/search?q=#{CGI.escape(board.title)}",
                          target: "_blank",rel: "noopener", class: "btn btn-outline-primary" %>
                     </li>
   <!-- 説明-->
                          <li class="shop-text">
                           <div class="fw-bold">ここがおすすめ！</div>
                          <div><%= board.body %></div>
                          </li>
    <!--ユーザー名-->     
                        <li>
                         <i class="bi bi-person"></i>
                         <%= board.user.name %>
                        </li>
    <!--作成日-->
                        <li>
                        <i class="bi bi-calendar"></i>
                        <%= l board.created_at, format: :short %>
                        </li>
    <!--各種ボタン-->
                     <% if current_user.own?(board) %>
                      <div class='ms-auto'>
                        <%= link_to edit_board_path(board), id: "button-edit-#{board.id}" do %>
                          <i class="bi bi-pencil-fill"></i>
                        <% end %>
                        <%= button_to "削除", board_path(board), method: :delete %>
                          <i class="bi bi-trash-fill"></i>
                        
                      </div>
                    <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>