<div class="col-sm-12 col-lg-4 mb-3">
              <div id="board-id-<%= board.id %>">
                <div class="shop-card">
                  <%= image_tag "shop-image.png", class: "shop-img-top", width: "200", height:"100" %>
                  <div class="shop-body">
                    <div class="d-flex">
          <ul class="list-unstyled shop-list">
    <!-- 店名-->
                      <li class="shop-title">
                        <%= link_to board.title, '#' %>
                      </li>
   <!-- google-->
                     <li>
                      <%= link_to "Googleで検索",
                         "https://www.google.com/search?q=#{CGI.escape(board.title)}",
                          target: "_blank",rel: "noopener", class: "btn btn-outline-primary" %>
                     </li>
   <!-- 説明-->
                          <li class="shop-text">
                           <div class="fw-bold">ここがおすすめ！</div>
                          <div><%= board.body %></div>
                          </li>
    <!--ユーザー名-->     
                        <li>
                         <i class="bi bi-person"></i>
                         <%= board.user.name %>
                        </li>
    <!--作成日-->
                        <li>
                        <i class="bi bi-calendar"></i>
                        <%= l board.created_at, format: :short %>
                        </li>
    <!--各種ボタン-->
                      <div class='ms-auto'>
                        <%= link_to '#', id: "button-edit-#{board.id}" do %>
                          <i class="bi bi-pencil-fill"></i>
                        <% end %>
                        <%= link_to '#', id: "button-delete-#{board.id}", method: :delete, data: {confirm: ''} do %>
                          <i class="bi bi-trash-fill"></i>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>