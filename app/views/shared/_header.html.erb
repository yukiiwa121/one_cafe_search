<header>
 <nav class='navbar navbar-expand-lg navigation navbar-light bg-light'>
  <%= link_to root_path, class: 'top-logo' do %>
   <%= image_tag 'image_log.png' , style: 'width: 150px; height: 100px;' %>
    <% end %>
 
    <button class='navbar-toggler' type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent'
      aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation'>
        <span class='navbar-toggler-icon'></span>
    </button>

    <div class='collapse navbar-collapse' id='navbarSupportedContent'>
      <ul class='navbar-nav ms-auto align-items-center'>
       <li class='nav-item dropdown'>
        <%= link_to 'おすすめカフェ' , '#', class: 'nav-link dropdown-toggle',  
          role: 'button', data: { bs_toggle: 'dropdown' , turbo: false } %>

         <ul class='dropdown-menu dropdown-menu-end'>
         <li>
          <%= link_to 'おすすめカフェ一覧', boards_path, class: 'dropdown-item' %>
          </li>
          <li>
          <%= link_to '新規カフェ登録', new_board_path, class: 'dropdown-item' %>
          </li>
         </ul>
      </li>

        <li class='nav-item dropdown dropdown-slide'>
          <%= link_to '#', class: 'nav-link dropdown-toggle', data: { bs_toggle: 'dropdown' , turbo: false }, role: 'button' do %>
           <%= image_tag 'prof-image.png' , class: 'rounded-circle', style: 'width: 40px; height: 40px;' %>
          <% end %>
         <ul class='dropdown-menu dropdown-menu-end'>
            <div class='dropdown-item'></div>
            <div class="dropdown-item text-center"><%= current_user.full_name %></div>
           <li>

           <!--プロフィールは未学習のため非表示-->
            <!-- <%= link_to 'プロフィール', '#', class: 'dropdown-item' %> -->
            </li>
            
            <li><hr class="dropdown-divider"></li>
            <li>
            <%= button_to 'ログアウト', logout_path, method: :delete ,class: 'dropdown-item' %>
            </li>
         </ul>
        </li>
      </ul>
    </div>
    </nav>
</header>






